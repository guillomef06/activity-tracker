{
  "$schema": "../node_modules/@angular/service-worker/config/schema.json",
  "index": "/activity-tracker/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/activity-tracker/favicon.png",
          "/activity-tracker/index.html",
          "/activity-tracker/*.css",
          "/activity-tracker/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/activity-tracker/assets/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "supabase-api",
      "urls": ["https://yeczvyyxchssftvnobdn.supabase.co/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1h",
        "timeout": "10s"
      }
    }
  ]
}
