# Identifiants du compte admin utilisé par les tests Playwright (e2e).
# Copier ce fichier en .env.e2e (gitignoré) et renseigner le mot de passe.
# En CI, définir les mêmes noms comme GitHub Secrets / Variables.
#
# Compte : admin du serveur ERA008-DEMO (jamais le vrai serveur ERA008).
E2E_BASE_URL=http://localhost:4200
E2E_SERVER_NAME=ERA008-DEMO
E2E_USERNAME=e2e_admin
E2E_PASSWORD=
E2E_DISPLAY_NAME="E2E Admin"
E2E_RECOVERY_QUESTION_ID=1
E2E_RECOVERY_ANSWER=
